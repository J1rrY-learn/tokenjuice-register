# 复制成 .env 后填入真实值。
#
# `.env` 已在 .gitignore 里（通配 `.env.*`）。
# 本文件是唯一的配置真源说明：代码里不留任何真实默认值，
# 缺哪一项由 `run_e2e.py --doctor` / `config.validate()` 显式报出来。

# ── 收信：CF Temp Email Worker ─────────────────────────────────────
# 支持两代 API（自动探测，见 src/tempemail.py 的 _is_legacy）：
#
#   新版（v2，按收件人索引）
#     POST {BASE}/api/mailboxes   Authorization: Bearer <admin key>
#     GET  {BASE}/api/inbox?email=
#
#   旧版（v1.x，地址级 jwt）
#     POST {BASE}/api/new_address  x-admin-auth: <admin key>
#     GET  {BASE}/api/mails?limit=
#   旧版地址级 jwt 由客户端自动保存，admin key 留空也可（匿名建址）。

TEMPMAIL_ADMIN_KEY=
# Worker 根地址，形如 https://<你的-worker-子域>.workers.dev
TEMPMAIL_BASE=
# 建临时邮箱用的域名（必须是 Worker 返回的 domains 之一）
TEMPMAIL_DOMAIN=

# ── Token Juice 站点与网关（选填）──────────────────────────────────
# 控制面 SITE_ORIGIN 写死在 src/config.py
TOKENJUICE_API_ORIGIN=https://api.tokenjuice.ai/v1
TOKENJUICE_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
